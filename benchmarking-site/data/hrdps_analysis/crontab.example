# HRDPS analysis live GRIB archive (issue #20)
#
# Copy into crontab -e. Replace /path/to/weatherloo-internal with your checkout.
# Runs at 02:30, 08:30, 14:30, 20:30 UTC (~2.5 h after each model cycle).
#
# Logs append to .cache/hrdps_grib/cache.log (gitignored).

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

30 2,8,14,20 * * * /path/to/weatherloo-internal/benchmarking-site/data/hrdps_analysis/cache_daily.sh >> /path/to/weatherloo-internal/.cache/hrdps_grib/cache.log 2>&1
